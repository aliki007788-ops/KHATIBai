# ==========================
# GENERAL
# ==========================
ENVIRONMENT=development
APP_NAME=Khatib
APP_VERSION=5.0.0
DEBUG=true

# ==========================
# DATABASE
# ==========================
# Development:
DATABASE_URL=sqlite:///./data/khatib.db
# Production (اجباری برای production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/khatib

# ==========================
# REDIS
# ==========================
REDIS_URL=redis://localhost:6379/0

# ==========================
# SECURITY (این‌ها را با مقادیر واقعی و تصادفی جایگزین کن - هرگز commit نکن)
# ==========================
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_64_CHARS
PASSWORD_PEPPER=CHANGE_ME_GENERATE_RANDOM_32_CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_SECURE=false
COOKIE_DOMAIN=

# ==========================
# CORS
# ==========================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1

# ==========================
# AI PROVIDER
# ==========================
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_SECONDS=1.0
AI_MAX_CONTEXT_TOKENS=6000

# ==========================
# PAYMENT
# ==========================
PAYMENT_PROVIDER=demo
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=
ZARINPAL_SANDBOX=true

# ==========================
# EITAA
# ==========================
EITAA_BOT_TOKEN=
EITAA_WEBHOOK_SECRET=

# ==========================
# STORAGE
# ==========================
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=khatib-audio

# ==========================
# PRODUCTION FLAGS
# ==========================
REDIS_REQUIRED=true
WORKER_REQUIRED=true
METRICS_ENABLED=true
SENTRY_DSN=

# ==========================
# LIMITS
# ==========================
MAX_UPLOAD_SIZE_BYTES=15728640
MAX_AUDIO_DURATION_SECONDS=600
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Frontend SPA URL (payment result redirects)
FRONTEND_URL=http://localhost:3000
